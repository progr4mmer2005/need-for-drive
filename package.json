    "prettier": "prettier --write src"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "gh-pages": "^6.3.0",
    "parcel": "^2.16.4",
    "prettier": "3.2.5",
    "sass": "^1.99.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-scss": "^6.14.0"
  },
  "dependencies": {
    "swiper": "^12.1.3"
  }
}
